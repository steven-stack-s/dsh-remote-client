{
  "name": "dsh-remote-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "直载远端 dsh 的桌面客户端",
  "main": "out/main/index.js",
  "scripts": {
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run",
    "test:build": "pnpm build && vitest run tests/build-artifacts.test.ts",
    "test:watch": "vitest",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:win:portable": "pnpm build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
